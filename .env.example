# Helm13F — environment template.
# Copy to `.env.local` (gitignored) and fill in real values for local dev.
# Production values are set via `flyctl secrets set ...` (see Phase 4).

# ---------- SEC EDGAR ----------
# REQUIRED. SEC mandates a real contact identifier on every request.
# Format: "<App-Name> <real-name> <real-email@domain>"
# Example: "Helm13F Victor Valour victor@example.com"
EDGAR_USER_AGENT=

# ---------- Postgres (Neon free tier in production) ----------
# REQUIRED. Standard postgres URL. SSL on.
# Local dev: postgres://helm13f:helm13f@localhost:5432/helm13f
DATABASE_URL=

# ---------- Redis (Upstash free tier in production) ----------
# REQUIRED. ioredis-compatible URL.
# Local dev: redis://localhost:6379
REDIS_URL=

# ---------- OpenFIGI ----------
# OPTIONAL in dev (rate limit drops to 25/min); REQUIRED for production.
# Generate at https://www.openfigi.com/api
OPENFIGI_API_KEY=

# ---------- Context Protocol (Phase 5+) ----------
# Generated at https://ctxprotocol.com/developer after registering the tool.
# Required for the live MCP server to authenticate paid calls; not needed for local schema/parser tests.
CONTEXT_API_KEY=
TOOL_ID=

# ---------- Server ----------
# HTTP port the MCP server listens on. Fly.io expects 8080 by default.
PORT=8080

# trace | debug | info | warn | error
LOG_LEVEL=info

# ---------- Ingestion ----------
# off    — never run ingestion (use seeded fixtures, e.g. for CI)
# cron   — run on the daily/weekly schedule (default in production)
# oneshot — run once and exit (used by the backfill script)
INGESTION_MODE=cron
